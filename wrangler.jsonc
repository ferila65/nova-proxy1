{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-proxy1",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "962ede22-7d2d-4375-87ff-ea98a3820fdc","database_name": "nova-proxy" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "b4932d5d581c4d1ca86a1aefb4927e83" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
